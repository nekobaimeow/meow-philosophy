{
    "$defs": {
        "Concept": {
            "additionalProperties": false,
            "description": "\u55b5\u54f2\u5b66\u4e2d\u7684\u4e00\u4e2a\u6982\u5ff5\u8282\u70b9",
            "properties": {
                "article": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "date": {
                    "format": "date",
                    "type": "string"
                },
                "description": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "family": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "id": {
                    "description": "\u5f62\u5982 concept-01, concept-08a \u7b49",
                    "pattern": "^concept-\\d{2}[a-z]?$",
                    "type": "string"
                },
                "is_metaphor_layer": {
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "keywords": {
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "label": {
                    "description": "\u4e2d\u6587\u6982\u5ff5\u540d\uff0c\u5982\u300c\u95f4\u6027\u672c\u4f53\u8bba\u300d",
                    "type": "string"
                },
                "relations_out": {
                    "items": {
                        "$ref": "#/$defs/ConceptRelation"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "required": [
                "id",
                "label",
                "date"
            ],
            "title": "Concept",
            "type": "object"
        },
        "ConceptFamily": {
            "additionalProperties": false,
