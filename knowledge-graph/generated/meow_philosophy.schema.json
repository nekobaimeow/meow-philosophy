            "type": "object"
        },
        "ExhaustedFamily": {
            "additionalProperties": false,
            "description": "\u5df2\u7a77\u5c3d\u7684\u6982\u5ff5\u65cf\uff08\u501f\u9274 SkillOpt rejected-edit buffer\uff09",
            "properties": {
                "cooldown_until": {
                    "format": "date",
                    "type": "string"
                },
                "exhausted_at": {
                    "format": "date",
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
