                "exhausted_at",
                "cooldown_until"
            ],
            "title": "ExhaustedFamily",
            "type": "object"
        },
        "ExplorationBudget": {
            "additionalProperties": false,
            "description": "\u63a2\u7d22\u9884\u7b97\u914d\u7f6e\uff08\u501f\u9274 SkillOpt textual LR budget\uff09",
            "properties": {
                "cooldown_days": {
                    "minimum": 1,
                    "type": "integer"
                },
                "max_concepts_per_family": {
                    "minimum": 1,
                    "type": "integer"
                },
                "min_family_score": {
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": "number"
                },
                "novelty_reject_threshold": {
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": "number"
                },
                "novelty_warn_threshold": {
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": "number"
                }
            },
            "required": [
                "max_concepts_per_family",
                "cooldown_days",
                "novelty_reject_threshold",
                "novelty_warn_threshold",
                "min_family_score"
            ],
            "title": "ExplorationBudget",
            "type": "object"
        },
